{
  "$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "mutate": [
    "supervisor/src/app/store.ts",
    "supervisor/src/app/commands.ts",
    "supervisor/src/app/supervisor-lease.ts",
    "supervisor/src/app/fence.ts",
    "supervisor/src/app/apply-commands.ts",
    "supervisor/src/app/outbox.ts",
    "supervisor/src/app/recovery.ts",
    "supervisor/src/app/supervisor-loop.ts",
    "supervisor/src/core/scope.ts",
    "supervisor/src/core/graph.ts"
  ],
  "testRunner": "vitest",
  "plugins": [
    "@stryker-mutator/vitest-runner"
  ],
  "reporters": [
    "clear-text",
    "json"
  ],
  "concurrency": 1,
  "thresholds": {
    "high": 80,
    "low": 70,
    "break": 80
  }
}
