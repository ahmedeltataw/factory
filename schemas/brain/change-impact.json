{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "call_id",
    "status",
    "provenance",
    "confidence",
    "policy_check",
    "impact",
    "affected_tasks",
    "affected_paths",
    "adr_required",
    "migration_steps",
    "risk",
    "decision"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "call_id": { "type": "string", "minLength": 1 },
    "status": { "type": "string", "enum": ["ok", "insufficient_evidence", "escalate"] },
    "provenance": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["source", "ref", "claim"],
        "properties": {
          "source": { "type": "string", "minLength": 1 },
          "ref": { "type": "string", "minLength": 1 },
          "claim": { "type": "string", "minLength": 1 }
        }
      }
    },
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
    "policy_check": {
      "type": "object",
      "additionalProperties": false,
      "required": ["allowed", "vetoes"],
      "properties": {
        "allowed": { "type": "boolean" },
        "vetoes": { "type": "array", "items": { "type": "string" } }
      }
    },
    "impact": { "type": "string" },
    "affected_tasks": { "type": "array", "items": { "type": "string" } },
    "affected_paths": { "type": "array", "items": { "type": "string" } },
    "adr_required": { "type": "boolean" },
    "adr": {
      "anyOf": [
        { "type": "null" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["title", "decision", "consequences"],
          "properties": {
            "title": { "type": "string" },
            "decision": { "type": "string" },
            "consequences": { "type": "array", "items": { "type": "string" } }
          }
        }
      ]
    },
    "migration_steps": { "type": "array", "items": { "type": "string" } },
    "risk": { "type": "string", "enum": ["low", "medium", "high"] },
    "decision": { "type": "string", "enum": ["proceed", "require_adr", "reject", "escalate"] },
    "breaks_contract": { "type": "boolean" },
    "new_dependencies": { "type": "array", "items": { "type": "string" } }
  }
}
