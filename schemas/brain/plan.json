{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "call_id",
    "status",
    "provenance",
    "confidence",
    "policy_check",
    "assumptions",
    "adrs",
    "task_graph",
    "golden_choice",
    "escalation"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "call_id": { "type": "string", "minLength": 1 },
    "status": { "type": "string", "enum": ["ok", "insufficient_evidence", "escalate"] },
    "provenance": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["source", "ref", "claim"],
        "properties": {
          "source": { "type": "string", "minLength": 1 },
          "ref": { "type": "string", "minLength": 1 },
          "claim": { "type": "string", "minLength": 1 }
        }
      }
    },
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
    "policy_check": {
      "type": "object",
      "additionalProperties": false,
      "required": ["allowed", "vetoes"],
      "properties": {
        "allowed": { "type": "boolean" },
        "vetoes": { "type": "array", "items": { "type": "string" } }
      }
    },
    "assumptions": { "type": "array", "items": { "type": "string" } },
    "adrs": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["title", "decision", "consequences"],
        "properties": {
          "title": { "type": "string" },
          "decision": { "type": "string" },
          "consequences": { "type": "array", "items": { "type": "string" } }
        }
      }
    },
    "task_graph": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "title", "owner", "scope", "deps", "done"],
        "properties": {
          "id": { "type": "string" },
          "title": { "type": "string" },
          "owner": { "type": "string" },
          "scope": { "type": "array", "items": { "type": "string" } },
          "deps": { "type": "array", "items": { "type": "string" } },
          "done": { "type": "array", "items": { "type": "string" } },
          "new_dependencies": { "type": "array", "items": { "type": "string" } }
        }
      }
    },
    "golden_choice": { "type": ["string", "null"] },
    "escalation": { "type": ["string", "null"] },
    "invented_destinations": { "type": "array", "items": { "type": "string" } }
  }
}
