{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "call_id",
    "status",
    "provenance",
    "confidence",
    "policy_check",
    "ruling",
    "reasoning_summary",
    "required_changes",
    "accepted_findings",
    "escalation"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "call_id": { "type": "string", "minLength": 1 },
    "status": { "type": "string", "enum": ["ok", "insufficient_evidence", "escalate"] },
    "provenance": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["source", "ref", "claim"],
        "properties": {
          "source": { "type": "string", "minLength": 1 },
          "ref": { "type": "string", "minLength": 1 },
          "claim": { "type": "string", "minLength": 1 }
        }
      }
    },
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
    "policy_check": {
      "type": "object",
      "additionalProperties": false,
      "required": ["allowed", "vetoes"],
      "properties": {
        "allowed": { "type": "boolean" },
        "vetoes": { "type": "array", "items": { "type": "string" } }
      }
    },
    "ruling": { "type": "string", "enum": ["approve", "request_changes", "escalate"] },
    "reasoning_summary": { "type": "string" },
    "required_changes": { "type": "array", "items": { "type": "string" } },
    "accepted_findings": { "type": "array", "items": { "type": "string" } },
    "escalation": { "type": ["string", "null"] },
    "risk": { "type": "string", "enum": ["low", "medium", "high"] },
    "lead_reviewed": { "type": "boolean" },
    "violates_adr": { "type": "boolean" }
  }
}
