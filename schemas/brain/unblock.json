{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "call_id",
    "status",
    "provenance",
    "confidence",
    "policy_check",
    "root_cause",
    "evidence",
    "action",
    "question",
    "stop"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "call_id": { "type": "string", "minLength": 1 },
    "status": { "type": "string", "enum": ["ok", "insufficient_evidence", "escalate"] },
    "provenance": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["source", "ref", "claim"],
        "properties": {
          "source": { "type": "string", "minLength": 1 },
          "ref": { "type": "string", "minLength": 1 },
          "claim": { "type": "string", "minLength": 1 }
        }
      }
    },
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
    "policy_check": {
      "type": "object",
      "additionalProperties": false,
      "required": ["allowed", "vetoes"],
      "properties": {
        "allowed": { "type": "boolean" },
        "vetoes": { "type": "array", "items": { "type": "string" } }
      }
    },
    "root_cause": { "type": "string" },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["source", "claim"],
        "properties": {
          "source": { "type": "string" },
          "claim": { "type": "string" }
        }
      }
    },
    "action": {
      "type": "string",
      "enum": [
        "continue",
        "retry_with_change",
        "split_task",
        "reassign",
        "write_adr",
        "escalate_designer",
        "ask_question",
        "stop"
      ]
    },
    "question": { "type": ["string", "null"] },
    "stop": { "type": "boolean" },
    "retry_change": { "type": ["string", "null"] },
    "reassignment": {
      "anyOf": [
        { "type": "null" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["role", "reason"],
          "properties": {
            "role": { "type": "string" },
            "reason": { "type": "string" }
          }
        }
      ]
    },
    "split_tasks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["title", "scope", "done"],
        "properties": {
          "title": { "type": "string" },
          "scope": { "type": "array", "items": { "type": "string" } },
          "done": { "type": "array", "items": { "type": "string" } }
        }
      }
    },
    "adr": {
      "anyOf": [
        { "type": "null" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["title", "decision", "consequences"],
          "properties": {
            "title": { "type": "string" },
            "decision": { "type": "string" },
            "consequences": { "type": "array", "items": { "type": "string" } }
          }
        }
      ]
    },
    "waived_severities": {
      "type": "array",
      "items": { "type": "string", "enum": ["S0", "S1", "S2", "S3", "S4"] }
    },
    "destructive": { "type": "boolean" },
    "policy_override": { "type": "boolean" },
    "target_paths": { "type": "array", "items": { "type": "string" } }
  }
}
