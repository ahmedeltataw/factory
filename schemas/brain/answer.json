{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "call_id",
    "status",
    "provenance",
    "confidence",
    "policy_check",
    "answer",
    "actions",
    "evidence_needed",
    "escalation"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "call_id": { "type": "string", "minLength": 1 },
    "status": { "type": "string", "enum": ["ok", "insufficient_evidence", "escalate"] },
    "provenance": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["source", "ref", "claim"],
        "properties": {
          "source": { "type": "string", "minLength": 1 },
          "ref": { "type": "string", "minLength": 1 },
          "claim": { "type": "string", "minLength": 1 }
        }
      }
    },
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
    "policy_check": {
      "type": "object",
      "additionalProperties": false,
      "required": ["allowed", "vetoes"],
      "properties": {
        "allowed": { "type": "boolean" },
        "vetoes": { "type": "array", "items": { "type": "string" } }
      }
    },
    "answer": { "type": ["string", "null"] },
    "actions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["kind", "detail"],
        "properties": {
          "kind": { "type": "string", "enum": ["guide", "request_edit", "waive_criterion", "escalate"] },
          "detail": { "type": "string" },
          "target_paths": { "type": "array", "items": { "type": "string" } }
        }
      }
    },
    "evidence_needed": { "type": "array", "items": { "type": "string" } },
    "escalation": { "type": ["string", "null"] }
  }
}
